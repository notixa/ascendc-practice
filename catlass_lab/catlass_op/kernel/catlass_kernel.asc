/**
 * catlass_kernel.asc —— FATkernel 的 ASC 侧：__global__ 入口 + host wrapper
 *
 * 类型契约（dtype / tile / 4 个 Block / FatKernelType）全部在 fat_types.h，
 * 这里不再写任何别名 —— 改契约只改一个地方。
 *
 * 与 catlass_op/src/catlass_torch.cpp 的分界：
 *   本文件（bisheng 编）   ：kernel + 启动语法 `<<<>>>`
 *   catlass_torch.cpp（gcc）：torch 接口 + tiling/workspace + aclrt 调用
 */

#include <cstddef>
#include <cstdint>

#include "kernel_operator.h"

#include "fat_types.h"      // ← 编译期契约（间接包含 fat_kernel.h / fat_tiling.h）
#include "catlass_kernel.h" // ← 自己的声明，保证签名一致

using namespace Catlass;

// ---------------------------------------------------------------------------
// __global__ 入口：逐个 GM_ADDR 传参（照 fai.cpp）
//
// 不传 struct 的原因：FATParams 里是 __gm__ 指针，按值传给 __global__ 有风险；
// 而 uint8_t* → GM_ADDR 是隐式转换，bisheng 允许（显式 reinterpret_cast 反而被禁）。
// ---------------------------------------------------------------------------
extern "C" __global__ __aicore__ void fat_impl(
    uint64_t hwSyncAddr,
    GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR mask, GM_ADDR o,
    GM_ADDR s, GM_ADDR p, GM_ADDR oTemp, GM_ADDR tiling)
{
    // ★ A2 上 AIC/AIV 是两个核，跨核 flag 必须基于这个硬件同步基地址。
    //   不设的话 CrossCoreSetFlag/WaitFlag 落在错误的同步区 → AIV 永远等不到 qkReady → 卡死。
    //   （官方模板说"纯 AIC 的 matmul 不需要"，FA 是 AIC+AIV，属于例外。）
    AscendC::SetSyncBaseAddr(hwSyncAddr);

    FATParams params{q, k, v, mask, o, s, p, oTemp, tiling};
    fat::FatKernelType op;
    op(params);      // 不带模板参数：由 g_coreType 选 operator()<AIC> / <AIV>
}

// ---------------------------------------------------------------------------
// 最小 AIC↔AIV 往返测试（诊断用）
//
// 只做两个方向的 flag 握手，不带任何计算：
//   AIC: set f1 ──────────────────────────────► wait f2 ─► out[2] = 222
//   AIV:          wait f1 ─► out[1] = 111 ─► set f2
//
// 判读：
//   out = [_, 111, 222]  → 两个方向都通
//   out = [_, 111,   0]  → AIV→AIC 不通（和我们 kernel 的症状一致）
//   卡死                  → 同上，或整条链不通
// ---------------------------------------------------------------------------
extern "C" __global__ __aicore__ void fat_pingpong_impl(uint64_t hwSyncAddr, GM_ADDR out)
{
    AscendC::SetSyncBaseAddr(hwSyncAddr);

    Catlass::Arch::CrossCoreFlag f1{1};   // AIC -> AIV
    Catlass::Arch::CrossCoreFlag f2{2};   // AIV -> AIC

    AscendC::GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(out), 4);

    if ASCEND_IS_AIC {
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(f1);
        Catlass::Arch::CrossCoreWaitFlag(f2);
        g.SetValue(2, 222);
    }
    if ASCEND_IS_AIV {
        if (AscendC::GetBlockIdx() == 0) {
            Catlass::Arch::CrossCoreWaitFlag(f1);
            g.SetValue(1, 111);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(f2);
            g.SetValue(3, 333);
        }
    }
}

// ---------------------------------------------------------------------------
// host wrapper（bisheng 编的 host 部分，被 catlass_torch.cpp 调用）
// ---------------------------------------------------------------------------
namespace catlass_kernel {

void fat(uint64_t hwSyncAddr, uint32_t coreNum, void* stream,
         uint8_t* q, uint8_t* k, uint8_t* v, uint8_t* mask, uint8_t* o,
         uint8_t* s, uint8_t* p, uint8_t* oTemp, uint8_t* tiling)
{
    fat_impl<<<coreNum, nullptr, stream>>>(hwSyncAddr, q, k, v, mask, o, s, p, oTemp, tiling);
}

void pingpong(uint64_t hwSyncAddr, uint32_t coreNum, void* stream, uint8_t* out)
{
    fat_pingpong_impl<<<coreNum, nullptr, stream>>>(hwSyncAddr, out);
}

size_t get_fat_workspace_size(uint32_t coreNum, uint32_t B_q, uint32_t B_k, uint32_t headDim)
{
    // 必须与 catlass_torch.cpp 里三块 at::empty 的公式一致，
    // 且与 kernel 里 layoutS{B_q,B_k} / layoutP{B_q,B_k} / layoutOTmp{B_q,headDim} 的 stride 一致。
    const size_t sBytes  = (size_t)coreNum * B_q * B_k    * sizeof(float);
    const size_t pBytes  = (size_t)coreNum * B_q * B_k    * sizeof(half);
    const size_t otBytes = (size_t)coreNum * B_q * headDim * sizeof(float);
    return sBytes + pBytes + otBytes;
}

} // namespace catlass_kernel
